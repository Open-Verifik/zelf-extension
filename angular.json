{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "zelf-extension": {
            "prefix": "app",
            "projectType": "application",
            "root": "",
            "sourceRoot": "src",
            "schematics": {
                "@schematics/angular:application": {
                    "strict": true
                },
                "@schematics/angular:class": {},
                "@schematics/angular:directive": {},
                "@schematics/angular:guard": {},
                "@schematics/angular:interceptor": {},
                "@schematics/angular:pipe": {},
                "@schematics/angular:service": {}
            },
            "architect": {
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "main": "src/test.ts",
                        "polyfills": "src/polyfills.test.ts",
                        "tsConfig": "tsconfig.spec.json",
                        "karmaConfig": "karma.conf.js",
                        "assets": ["src/favicon.ico", "src/assets"],
                        "styles": ["src/styles.css"],
                        "scripts": []
                    }
                },
                "builder": {
                    "builder": "./builders:extension",
                    "defaultConfiguration": "dev_chrome",
                    "options": {
                        "webpackConfig": "webpack.extension.config.js"
                    },
                    "configurations": {
                        "prod_chrome": {
                            "angularTarget": "zelf-extension:build:ext_prod_chrome",
                            "mode": "production"
                        },
                        "dev_chrome": {
                            "angularTarget": "zelf-extension:build:ext_dev_chrome",
                            "mode": "development"
                        }
                    }
                },
                "build": {
                    "defaultConfiguration": "ext_dev_chrome",
                    "builder": "@angular-devkit/build-angular:browser",
                    "options": {
                        "baseHref": "./index.html",
                        "outputPath": "dist/dev",
                        "index": "configurations/index.html",
                        "main": "src/main.ts",
                        "polyfills": "src/polyfills.ts",
                        "tsConfig": "tsconfig.app.json",
                        "assets": [
                            "src/favicon.ico",
                            "src/assets",
                            "src/master.css",
                            {
                                "input": "configurations",
                                "output": "/",
                                "glob": "*.*"
                            }
                        ],
                        "allowedCommonJsDependencies": [
                            "@bitcoinerlab/secp256k1",
                            "poseidon-lite",
                            "bip32",
                            "ecpair",
                            "@ethereumjs/rlp",
                            "@tensorflow/tfjs-core",
                            "@vladmandic/face-api",
                            "bigint-buffer",
                            "bip39",
                            "bitcoinjs-lib",
                            "bs58",
                            "buffer",
                            "crc-32",
                            "cross-fetch",
                            "flat",
                            "jsqr",
                            "lodash",
                            "moment",
                            "qr-code-styling",
                            "qrcode",
                            "setimmediate",
                            "tweetnacl",
                            "webextension-polyfill",
                            "@stellar/stellar-sdk",
                            "@stellar/stellar-base",
                            "stellar-hd-wallet",
                            "urijs",
                            "@polkadot/api",
                            "@polkadot/rpc-provider",
                            "@polkadot/types",
                            "@polkadot/types-codec",
                            "@polkadot/types-known",
                            "@polkadot/types-create",
                            "@polkadot/rpc-core",
                            "@polkadot/rpc-augment",
                            "@polkadot/keyring",
                            "@polkadot/util",
                            "@polkadot/util-crypto",
                            "@polkadot/wasm-crypto",
                            "@polkadot/wasm-crypto-asmjs",
                            "@polkadot/wasm-crypto-wasm",
                            "@ton/core",
                            "@ton/crypto",
                            "@ton/ton",
                            "ed25519-hd-key"
                        ]
                    },
                    "configurations": {
                        "ext_prod_chrome": {
                            "buildOptimizer": true,
                            "extractLicenses": true,
                            "index": "configurations/index.html",
                            "namedChunks": false,
                            "outputHashing": "none",
                            "outputPath": "dist/prod",
                            "sourceMap": false,
                            "vendorChunk": false,
                            "assets": [
                                "src/assets",
                                "src/favicon.ico",
                                "src/master.css",
                                {
                                    "input": "configurations",
                                    "output": "/",
                                    "glob": "*.*"
                                },
                                {
                                    "input": "node_modules/webextension-polyfill/dist/",
                                    "output": "/",
                                    "glob": "*.min.*"
                                }
                            ],
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "5mb",
                                    "maximumError": "10mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "48kb",
                                    "maximumError": "56kb"
                                }
                            ],
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment-ext.prod.ts"
                                }
                            ],
                            "optimization": {
                                "fonts": true,
                                "scripts": true,
                                "styles": {
                                    "inlineCritical": false,
                                    "minify": true
                                }
                            }
                        },
                        "ext_dev_chrome": {
                            "buildOptimizer": false,
                            "extractLicenses": false,
                            "index": "configurations/index.html",
                            "namedChunks": true,
                            "optimization": false,
                            "outputPath": "dist/dev",
                            "sourceMap": true,
                            "vendorChunk": true,
                            "assets": [
                                "src/assets",
                                "src/favicon.ico",
                                "src/master.css",
                                {
                                    "input": "configurations",
                                    "output": "/",
                                    "glob": "*.*"
                                },
                                {
                                    "input": "node_modules/webextension-polyfill/dist/",
                                    "output": "/",
                                    "glob": "*.min.*"
                                }
                            ]
                        }
                    }
                },
                "serve": {
                    "builder": "@angular-devkit/build-angular:dev-server",
                    "defaultConfiguration": "ext_dev_chrome",
                    "configurations": {
                        "ext_dev_chrome": {
                            "buildTarget": "zelf-extension:build:ext_dev_chrome"
                        },
                        "ext_prod_chrome": {
                            "buildTarget": "zelf-extension:build:ext_prod_chrome"
                        }
                    }
                },
                "extract-i18n": {
                    "builder": "@angular-devkit/build-angular:extract-i18n",
                    "options": {
                        "buildTarget": "zelf-extension:build"
                    }
                },
                "e2e": {
                    "builder": "@puppeteer/ng-schematics:puppeteer",
                    "options": {
                        "devServerTarget": "zelf-extension:serve",
                        "testRunner": "jasmine"
                    }
                }
            }
        }
    },
    "cli": {
        "analytics": false
    }
}
