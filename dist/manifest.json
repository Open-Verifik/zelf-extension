{
	"description": "We solved the unsolvable, now you can never lose access to your crypto",
	"display": "standalone",
	"host_permissions": ["*://*/*"],
	"manifest_version": 3,
	"name": "Zelf Name Service",
	"orientation": "portrait-primary",
	"permissions": ["activeTab", "storage", "script-src-elem"],
	"start_url": "index.html",
	"version": "1.0",
	"action": {
		"default_popup": "index.html",
		"default_icon": "assets/icons/icon256.png"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["main.js"]
		}
	],
	"chrome_url_overrides": {
		"newtab": "index.html"
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self';",
		"google": "script-src https://www.google.com/recaptcha/, https://www.gstatic.com/recaptcha/; frame-src https://www.google.com/recaptcha/, https://recaptcha.google.com/recaptcha/;"
	},
	"icons": [
		{
			"src": "assets/icons/icon16.png",
			"purpose": "any",
			"type": "image/png",
			"sizes": "16x16"
		},
		{
			"src": "assets/icons/icon48.png",
			"purpose": "any",
			"type": "image/png",
			"sizes": "48x48"
		},
		{
			"src": "assets/icons/icon128.png",
			"purpose": "any",
			"type": "image/png",
			"sizes": "128x128"
		},
		{
			"src": "assets/icons/icon164.png",
			"purpose": "any",
			"type": "image/png",
			"sizes": "164x164"
		},
		{
			"src": "assets/icons/icon256.png",
			"purpose": "any",
			"type": "image/png",
			"sizes": "256x256"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["index.html", "styles.css", "main.js", "runtime.js", "polyfills.js", "background.js"],
			"matches": ["<all_urls>"]
		}
	]
}
