        "openpgp": "^5.11.1",
        "perfect-scrollbar": "1.5.5",
        "qr-code-styling": "^1.9.1",
        "qrcode": "^1.5.4",
        "rxjs": "7.8.1",
        "stellar-hd-wallet": "^1.0.2",
        "web3": "^4.8.0",
        "web3-validator": "^2.0.6",
        "webextension-polyfill": "^0.12.0",
        "zone.js": "^0.15.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^19.2.20",
        "@angular/cli": "^19.2.20",
        "@angular/compiler-cli": "^19.2.20",
        "@jsverse/transloco-keys-manager": "6.2.2",
        "@jsverse/transloco-optimize": "^7.0.1",
        "@types/bs58": "^4.0.4",
        "@types/chroma-js": "2.4.0",
        "@types/chrome": "^0.0.266",
        "@types/jasmine": "5.1.0",
        "@types/jasminewd2": "^2.0.10",
