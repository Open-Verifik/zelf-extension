{
    "name": "zelf-extension",
    "version": "2.1.11",
    "description": "Zelf Extension",
    "author": "https://verifik.co",
    "license": ".",
    "private": true,
    "scripts": {
        "build:dev": "ng run zelf-extension:builder:dev_chrome",
        "build:prod": "ng run zelf-extension:builder:prod_chrome && npm run test && npm run transloco:optimize",
        "build": "npm run bump:patch && npm run build:prod",
        "bump:major": "npm version major --no-git-tag-version && node scripts/sync-versions.js",
        "bump:minor": "npm version minor --no-git-tag-version && node scripts/sync-versions.js",
        "bump:patch": "npm version patch --no-git-tag-version && node scripts/sync-versions.js",
        "apply-translations": "node scripts/agent/translations/apply-translations.js",
        "check-translations": "node scripts/agent/translations/check-translations.js",
        "e2e:headless": "export E2E_HEADLESS=true && ng e2e",
        "e2e": "ng e2e",
        "i18n:find": "transloco-keys-manager find",
        "i18n:sync": "node scripts/sync-translations.js",
        "start": "ng serve",
        "test:ci": "ng test --browsers ChromeHeadlessCI --watch=false",
        "test:coverage": "ng test --code-coverage",
        "test:run": "ng test --browsers ChromeHeadless --watch=false",
        "test": "npm run test:run",
        "transloco:optimize": "transloco-optimize dist/prod/assets/i18n",
        "watch": "ng run zelf-extension:builder:dev_chrome --watch"
    },
    "overrides": {
        "qs": "^6.14.1",
        "elliptic": "^6.6.1",
        "bigint-buffer": "^1.1.5"
    },
    "dependencies": {
        "@angular/animations": "^19.2.20",
        "@angular/cdk": "^19.2.19",
        "@angular/common": "^19.2.20",
        "@angular/compiler": "^19.2.20",
        "@angular/core": "^19.2.20",
        "@angular/flex-layout": "^15.0.0-beta.42",
        "@angular/forms": "^19.2.20",
        "@angular/material": "^19.2.19",
        "@angular/material-luxon-adapter": "^19.2.19",
        "@angular/platform-browser": "^19.2.20",
        "@angular/platform-browser-dynamic": "^19.2.20",
        "@angular/router": "^19.2.20",
        "@babel/runtime": "^7.26.0",
        "@bitcoinerlab/secp256k1": "^1.2.0",
        "@coral-xyz/anchor": "^0.32.1",
        "@ethereumjs/wallet": "^2.0.3",
        "@ethersproject/sha2": "^5.8.0",
        "@fontsource/poppins": "^5.2.7",
        "@jsverse/transloco": "^7.6.1",
        "@mysten/seal": "^0.9.3",
        "@mysten/sui.js": "^0.54.1",
        "@openpgp/web-stream-tools": "^0.1.1",
        "@quicknode/sdk": "^2.4.2",
        "@scure/bip32": "^1.6.2",
        "@scure/bip39": "^1.5.4",
        "@solana/spl-token": "^0.4.13",
        "@stellar/stellar-sdk": "^14.6.1",
        "@tensorflow/tfjs-core": "^4.12.0",
        "@vladmandic/face-api": "^1.7.12",
        "@walletconnect/core": "^2.23.6",
        "@walletconnect/utils": "^2.23.6",
        "@walletconnect/web3wallet": "^1.16.1",
        "bip32": "^4.0.0",
        "bip39": "^3.1.0",
        "bitcoinjs-lib": "^6.1.7",
        "ecpair": "^2.1.0",
        "ed25519-hd-key": "^1.3.0",
        "ethers": "^6.12.1",
        "jsqr": "^1.4.0",
        "lightweight-charts": "^5.0.5",
        "material-symbols": "^0.39.2",
        "micro-key-producer": "^0.7.5",
        "moment": "^2.29.4",
