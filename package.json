{
    "name": "zelf-name-service",
    "version": "1.0.1",
    "description": "Zelf Name Service",
    "author": "https://verifik.co",
    "license": ".",
    "private": true,
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "npm run build:web && npm run build:ext",
        "build:web": "npm run build:web:prod",
        "build:web:prod": "ng build --configuration production",
        "build:ext": "npm run build:ext:chrome && npm run build:ext:firefox",
        "build:ext:chrome": "ng build --configuration 'ext_prod_chrome'",
        "build:ext:firefox": "ng build --configuration 'ext_prod_firefox'",
        "watch": "ng build --watch --configuration development",
        "watch:ext": "ng build --watch --configuration 'ext_dev_chrome'",
        "watch:ext:firefox": "ng build --watch --configuration 'ext_dev_firefox' & web-ext run --source-dir './dist/dev/ext/firefox' --devtools",
        "test": "ng test"
    },
    "dependencies": {
        "@angular/animations": "16.0.3",
        "@angular/cdk": "^16.0.2",
        "@angular/common": "16.0.3",
        "@angular/compiler": "16.0.3",
        "@angular/core": "16.0.3",
        "@angular/flex-layout": "^15.0.0-beta.42",
        "@angular/forms": "16.0.3",
        "@angular/material": "16.0.2",
        "@angular/material-luxon-adapter": "16.0.2",
        "@angular/platform-browser": "16.0.3",
        "@angular/platform-browser-dynamic": "16.0.3",
        "@angular/router": "16.0.3",
        "@babel/runtime": "^7.26.0",
        "@ethereumjs/wallet": "^2.0.3",
        "@mysten/sui.js": "^0.54.1",
        "@ngneat/transloco": "4.2.7",
        "@openpgp/web-stream-tools": "^0.1.1",
        "@quicknode/sdk": "^2.4.2",
        "@scure/bip32": "^1.6.2",
        "@scure/bip39": "^1.5.4",
        "@tensorflow/tfjs-core": "^4.12.0",
        "@vladmandic/face-api": "^1.7.12",
        "bip39": "^3.1.0",
        "buffer": "^6.0.3",
        "ethers": "^6.12.1",
        "jsqr": "^1.4.0",
        "moment": "^2.29.4",
        "ngx-webcam": "^0.4.1",
        "openpgp": "^5.11.1",
        "perfect-scrollbar": "1.5.5",
        "qr-code-styling": "^1.9.1",
        "qrcode": "^1.5.4",
        "rxjs": "7.8.1",
        "web3": "^4.8.0",
        "web3-validator": "^2.0.6",
        "webextension-polyfill": "^0.12.0",
        "zone.js": "0.13.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^16.2.16",
        "@angular/cli": "^16.2.6",
        "@angular/compiler-cli": "16.0.3",
        "@types/chroma-js": "2.4.0",
        "@types/chrome": "^0.0.266",
        "@types/jasmine": "4.3.2",
        "@types/lodash": "4.14.195",
        "@types/lodash-es": "4.17.7",
        "@types/luxon": "3.3.0",
        "@types/node-rsa": "^1.1.4",
        "@types/qrcode": "^1.5.5",
        "@types/webextension-polyfill": "^0.12.2",
        "autoprefixer": "10.4.14",
        "chroma-js": "2.4.2",
        "jasmine-core": "5.0.0",
        "lodash": "4.17.21",
        "postcss": "^8.4.31",
        "typescript": "5.0.4",
        "web-ext": "^8.4.0"
    }
}
